# Copy to .env for live experiments, then fill only the provider keys you need.
# Leave every value blank for offline validation. Never commit real credentials.

# Claude API (subscription authentication uses an external auth file instead).
ANTHROPIC_API_KEY=

# Codex / OpenCode OpenAI API.
OPENAI_API_KEY=

# OpenCode DeepSeek API.
DEEPSEEK_API_KEY=

# OpenCode, Muse, Grok, ZCode, and Kimi through OpenRouter.
OPENROUTER_API_KEY=

# Optional Muse-specific override; otherwise Muse uses OPENROUTER_API_KEY.
MUSE_OPENROUTER_API_KEY=

# Cursor and Gemini / Antigravity gateways.
CURSOR_API_KEY=
GEMINI_API_KEY=
